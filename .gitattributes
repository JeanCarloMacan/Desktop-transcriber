# Finales de línea normalizados en el repositorio (LF); cada sistema los adapta al hacer checkout.
* text=auto

# Scripts de PowerShell y por lotes: CRLF en Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Texto
*.py text
*.md text
*.toml text
*.json text
*.sql text
*.svg text
*.txt text
uv.lock text

# Binarios
*.png binary
*.jpg binary
*.wav binary
*.ico binary
