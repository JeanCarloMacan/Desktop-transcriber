{
  "openapi": "3.1.0",
  "info": {
    "title": "tasks-service",
    "description": "Tareas por categoría extraídas de los dictados de voice-core con un modelo local de LM Studio. Eventos en /ws y /events.",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Salud",
        "operationId": "salud_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/llm": {
      "get": {
        "summary": "Llm",
        "operationId": "llm_llm_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmOut"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Categorias",
        "operationId": "categorias_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryOut"
                  },
                  "type": "array",
                  "title": "Response Categorias Categories Get"
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Tareas",
        "operationId": "tareas_tasks_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "propuesta",
                    "pendiente",
                    "hecha",
                    "descartada"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskOut"
                  },
                  "title": "Response Tareas Tasks Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear",
        "operationId": "crear_tasks_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskOut"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/tasks/{task_id}": {
      "patch": {
        "summary": "Editar",
        "operationId": "editar_tasks__task_id__patch",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Task Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extractions": {
      "post": {
        "summary": "Extraer",
        "description": "Encola la extracción de tareas de un dictado terminado; sustituye sus propuestas anteriores.",
        "operationId": "extraer_extractions_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionIn"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Extracciones",
        "operationId": "extracciones_extractions_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExtractionOut"
                  },
                  "title": "Response Extracciones Extractions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Eventos",
        "operationId": "eventos_events_get",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TaskCreated"
                      },
                      {
                        "$ref": "#/components/schemas/TaskUpdated"
                      },
                      {
                        "$ref": "#/components/schemas/ExtractionUpdated"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "task.created": "#/components/schemas/TaskCreated",
                        "task.updated": "#/components/schemas/TaskUpdated",
                        "extraction.updated": "#/components/schemas/ExtractionUpdated"
                      }
                    }
                  },
                  "title": "Response Eventos Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shutdown": {
      "post": {
        "summary": "Cerrar Servicio",
        "operationId": "cerrar_servicio_shutdown_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShutdownOut"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "pending": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Pending"
          },
          "proposed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Proposed"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured",
            "description": "false = ya no está en la configuración; sus tareas siguen aquí"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "pending",
          "proposed",
          "configured"
        ],
        "title": "CategoryOut"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "ExtractionIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ExtractionIn"
      },
      "ExtractionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "origin": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "title": "Origin"
          },
          "status": {
            "type": "string",
            "enum": [
              "en_cola",
              "procesando",
              "lista",
              "error"
            ],
            "title": "Status"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tasks",
            "description": "Tareas propuestas"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S",
            "description": "Segundos de la llamada al modelo (carga incluida)"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "waiting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting",
            "description": "Motivo por el que sigue en cola (p. ej. la GPU de LM Studio está ocupada por otro programa); null si no espera"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "session_id",
          "origin",
          "status",
          "model",
          "tasks",
          "duration_s",
          "error",
          "created_at"
        ],
        "title": "ExtractionOut"
      },
      "ExtractionUpdated": {
        "properties": {
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq",
            "description": "Orden global de tasks-service"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "type": {
            "type": "string",
            "const": "extraction.updated",
            "title": "Type",
            "default": "extraction.updated"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "extraction": {
            "$ref": "#/components/schemas/ExtractionOut"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "ts",
          "session_id",
          "extraction"
        ],
        "title": "ExtractionUpdated"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "voice_core": {
            "type": "boolean",
            "title": "Voice Core",
            "description": "Conectado al WebSocket de voice-core"
          }
        },
        "type": "object",
        "required": [
          "version",
          "voice_core"
        ],
        "title": "HealthOut"
      },
      "LlmOut": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "loaded": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loaded",
            "description": "null si LM Studio no responde"
          },
          "ttl_s": {
            "type": "integer",
            "title": "Ttl S"
          }
        },
        "type": "object",
        "required": [
          "url",
          "model",
          "reachable",
          "loaded",
          "ttl_s"
        ],
        "title": "LlmOut"
      },
      "ShutdownOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "cerrando",
            "title": "Status",
            "default": "cerrando"
          }
        },
        "type": "object",
        "title": "ShutdownOut"
      },
      "TaskCreated": {
        "properties": {
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq",
            "description": "Orden global de tasks-service"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "type": {
            "type": "string",
            "const": "task.created",
            "title": "Type",
            "default": "task.created"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "task": {
            "$ref": "#/components/schemas/TaskOut"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "ts",
          "task"
        ],
        "title": "TaskCreated"
      },
      "TaskIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Category"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "category"
        ],
        "title": "TaskIn"
      },
      "TaskOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "status": {
            "type": "string",
            "enum": [
              "propuesta",
              "pendiente",
              "hecha",
              "descartada"
            ],
            "title": "Status"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Dictado de voice-core del que salió; null si se creó a mano"
          },
          "extraction_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Id"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote",
            "description": "Fragmento del dictado que la originó"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "done_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Done At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "due",
          "notes",
          "status",
          "session_id",
          "extraction_id",
          "quote",
          "created_at",
          "updated_at",
          "done_at"
        ],
        "title": "TaskOut"
      },
      "TaskPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pendiente",
                  "hecha",
                  "descartada"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "propuesta → pendiente es aprobarla; ninguna vuelve a propuesta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "TaskPatch",
        "description": "Solo cambian los campos presentes; `due` o `notes` a null los borran."
      },
      "TaskUpdated": {
        "properties": {
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq",
            "description": "Orden global de tasks-service"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "type": {
            "type": "string",
            "const": "task.updated",
            "title": "Type",
            "default": "task.updated"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "task": {
            "$ref": "#/components/schemas/TaskOut"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "ts",
          "task"
        ],
        "title": "TaskUpdated"
